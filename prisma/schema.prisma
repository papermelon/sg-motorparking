// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

enum Source {
  HDB
  COMMUNITY
  INFERRED
}

enum ConfidenceLevel {
  official
  community
  inferred
}

// PostgreSQL for production (Supabase/Vercel)
// For local development with SQLite, temporarily change provider to "sqlite"
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Carpark {
  id                     String   @id @default(cuid())
  externalId             String   @unique @default(cuid()) // HDB carpark number or generated ID
  name                   String
  address                String
  town                   String?  // e.g., "Bukit Batok", "Yishun", "Orchard"
  lat                    Float
  lng                    Float
  type                   String   // HDB, MALL, OFFICE, PUBLIC, OTHER
  source                 Source   @default(COMMUNITY)
  confidenceLevel        ConfidenceLevel @default(community)
  motorcycleAllowed      Boolean?
  carAllowed             Boolean  @default(true)
  totalMotoLots          Int?
  covered                Boolean?
  seasonOnly             Boolean?
  pricingNotes           String?
  openingHours           String?
  entranceNotes          String?
  verified               Boolean  @default(false) // For crowd-sourced moderation
  lastAvailabilitySyncAt DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  photos Photo[]
}

model Photo {
  id        String   @id @default(cuid())
  carparkId String
  url       String
  caption   String?
  takenAt   DateTime?
  createdAt DateTime @default(now())

  carpark Carpark @relation(fields: [carparkId], references: [id], onDelete: Cascade)
}

// PostgreSQL schema for Vercel/Supabase deployment
// Copy this to schema.prisma when deploying to production

generator client {
  provider = "prisma-client-js"
}

enum Source {
  HDB
  COMMUNITY
  INFERRED
}

enum ConfidenceLevel {
  official
  community
  inferred
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // For Supabase connection pooling
}

model Carpark {
  id                     String   @id @default(cuid())
  externalId             String   @unique @default(cuid()) // HDB carpark number or generated ID
  name                   String
  address                String
  town                   String?
  lat                    Float
  lng                    Float
  type                   String   // HDB, MALL, OFFICE, PUBLIC, OTHER
  source                 Source   @default(COMMUNITY)
  confidenceLevel        ConfidenceLevel @default(community)
  motorcycleAllowed      Boolean?
  carAllowed             Boolean  @default(true)
  totalMotoLots          Int?
  covered                Boolean?
  seasonOnly             Boolean?
  pricingNotes           String?
  openingHours           String?
  entranceNotes          String?
  verified               Boolean  @default(false)
  lastAvailabilitySyncAt DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  photos Photo[]

  @@index([lat, lng])
  @@index([verified])
}

model Photo {
  id        String    @id @default(cuid())
  carparkId String
  url       String
  caption   String?
  takenAt   DateTime?
  createdAt DateTime  @default(now())

  carpark Carpark @relation(fields: [carparkId], references: [id], onDelete: Cascade)

  @@index([carparkId])
}
